# ---------------------------------------------------------------------------
# Vessel — self-hosted production (home desktop + Cloudflare Tunnel)
# Copy to .env.selfhosted and fill in real values. NEVER commit this file.
# ---------------------------------------------------------------------------

# Your public hostname, with no trailing slash and no path.
APP_URL=https://profile.example.com
APP_NAME=Vessel

# --- Database --------------------------------------------------------------
# PostgreSQL runs inside the compose network. It is never published.
POSTGRES_USER=vessel
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=vessel

# --- Secrets ---------------------------------------------------------------
# openssl rand -base64 48
AUTH_SECRET=replace-with-48-random-bytes-base64
# openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# --- Sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=vessel_session
SESSION_TTL_DAYS=30

# --- Media -----------------------------------------------------------------
STORAGE_DRIVER=local
MAX_UPLOAD_MB=12
# The container writes to /srv/vessel/media, backed by the media_data volume.
# Point BACKUP_MEDIA_DIR at that volume's host path so backups can see it.

# --- Email -----------------------------------------------------------------
# Use a real provider; "console" prints links to the container log.
MAIL_DRIVER=smtp
MAIL_FROM="Vessel <no-reply@your-domain.example>"
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Networking ------------------------------------------------------------
# True because traffic arrives through Cloudflare Tunnel / cloudflared.
TRUST_PROXY=true
# Extra origins allowed to POST forms (comma separated) — usually not needed.
ALLOWED_ORIGINS=
# Loopback port the app binds to; the tunnel targets it.
WEB_PORT=3000

# --- Cloudflare Tunnel -----------------------------------------------------
# From: Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Resource limits -------------------------------------------------------
WEB_MEMORY_LIMIT=768M
DB_MEMORY_LIMIT=512M

# --- Feature flags ---------------------------------------------------------
FEATURE_BILLING=false
FEATURE_INTEGRATIONS=false
