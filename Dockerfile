# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# null — production image
#
# Multi-stage build producing a small standalone Next.js server. The same image
# runs on a laptop, the self-hosted desktop and a cloud VPS; behaviour is chosen
# by environment variables only.
# ---------------------------------------------------------------------------

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# --- Dependencies ----------------------------------------------------------
FROM base AS deps
COPY package.json package-lock.json* ./
# `--omit=optional` keeps the install lean but sharp's platform binaries are
# optional deps, so they are required at build time. Keep them.
RUN npm ci --no-audit --no-fund

# --- Build -----------------------------------------------------------------
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# A placeholder URL lets the build type-check pages that read APP_URL without
# requiring production secrets at image-build time.
ENV DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder" \
    AUTH_SECRET="build-time-placeholder-secret-value-000000" \
    APP_ENCRYPTION_KEY="build-time-placeholder-key" \
    APP_URL="http://localhost:3000"
RUN npm run build

# --- Runtime ---------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Run unprivileged. The media root is a volume owned by this user.
RUN groupadd --system --gid 1001 null \
 && useradd --system --uid 1001 --gid null --create-home null \
 && mkdir -p /srv/null/media \
 && chown -R null:null /srv/null

COPY --from=builder --chown=null:null /app/.next/standalone ./
COPY --from=builder --chown=null:null /app/.next/static ./.next/static
# Static assets. The app icon and manifest are generated by the app router.
COPY --from=builder --chown=null:null /app/public ./public
# Migrations plus the plain-JS runner used by the release step. Only runtime
# dependencies are needed: drizzle-orm and pg are already in the standalone tree.
COPY --from=builder --chown=null:null /app/src/db/migrations ./src/db/migrations
COPY --from=builder --chown=null:null /app/scripts/db-migrate.mjs ./scripts/db-migrate.mjs

USER null
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
