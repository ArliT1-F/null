# ---------------------------------------------------------------------------
# null — cloud production
# Copy to .env.cloud and fill in real values. NEVER commit this file.
# ---------------------------------------------------------------------------

APP_URL=https://null.example.com
APP_NAME=null

# --- Database --------------------------------------------------------------
# Managed PostgreSQL is recommended in the cloud. If you use the bundled
# container instead, keep POSTGRES_* set and remove the note below.
DATABASE_URL=postgresql://null:password@your-db-host:5432/null
POSTGRES_USER=null
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=null

# --- Secrets ---------------------------------------------------------------
AUTH_SECRET=replace-with-48-random-bytes-base64
APP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

SESSION_COOKIE_NAME=null_session
SESSION_TTL_DAYS=30

# --- Media (Cloudflare R2 or any S3-compatible store) ----------------------
STORAGE_DRIVER=s3
MAX_UPLOAD_MB=25
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=null-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN hostname in front of the bucket (optional but recommended).
S3_PUBLIC_BASE_URL=https://media.example.com

# --- Email -----------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_FROM="null <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Networking ------------------------------------------------------------
TRUST_PROXY=true
ALLOWED_ORIGINS=
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
WEB_MEMORY_LIMIT=1024M

FEATURE_BILLING=false
FEATURE_INTEGRATIONS=false
