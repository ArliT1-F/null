# ---------------------------------------------------------------------------
# Vessel — example environment configuration
# Copy to .env (development) and fill in real values. NEVER commit secrets.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Public origin used for metadata, canonical URLs, OG images and emails.
# No trailing slash.
APP_URL=http://localhost:3000
APP_NAME=Vessel

# --- Database --------------------------------------------------------------
# Single PostgreSQL instance. The database is never exposed publicly.
DATABASE_URL=postgresql://vessel:vessel@localhost:5432/vessel

# --- Secrets ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-48-random-bytes-base64
# 32-byte key, base64 or hex, used for AES-256-GCM encryption of OAuth tokens.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64

# --- Sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=vessel_session
SESSION_TTL_DAYS=30

# --- Media storage ---------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
# Where uploads are written. Leave it unset for the default: ./media in
# development (gitignored) and /srv/vessel/media in production. Docker Compose
# already sets the container path; on a bare-metal install use an absolute path
# outside the source tree, e.g. /srv/vessel/media.
# MEDIA_ROOT=/srv/vessel/media
# Public request prefix for media (served by the app, not a static mount).
MEDIA_PUBLIC_PREFIX=/api/media
MAX_UPLOAD_MB=12

# S3 / Cloudflare R2 (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=vessel-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN host for public reads, e.g. https://media.example.com
S3_PUBLIC_BASE_URL=

# --- Email -----------------------------------------------------------------
# console (development) | smtp
MAIL_DRIVER=console
MAIL_FROM="Vessel <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Security --------------------------------------------------------------
# Set to true behind a trusted reverse proxy / Cloudflare Tunnel.
TRUST_PROXY=false
# Comma-separated extra hosts allowed as request origin (besides APP_URL).
ALLOWED_ORIGINS=

# --- Feature flags ---------------------------------------------------------
# V1 ships without billing or third-party integrations. These stay false until
# the corresponding roadmap phase is implemented.
FEATURE_BILLING=false
FEATURE_INTEGRATIONS=false
